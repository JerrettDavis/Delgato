# Delgato CLI Dockerfile
# Multi-stage build for optimized production image

FROM mcr.microsoft.com/dotnet/runtime:10.0 AS base
WORKDIR /app

# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG BUILD_VERSION=1.0.0
WORKDIR /src

# Copy solution and project files
COPY ["Delgato.slnx", "."]
COPY ["Delgato.Core/Delgato.Core.csproj", "Delgato.Core/"]
COPY ["Delgato.Providers/Delgato.Providers.csproj", "Delgato.Providers/"]
COPY ["Delgato.Orchestration/Delgato.Orchestration.csproj", "Delgato.Orchestration/"]
COPY ["Delgato.Governance/Delgato.Governance.csproj", "Delgato.Governance/"]
COPY ["Delgato.Configuration/Delgato.Configuration.csproj", "Delgato.Configuration/"]
COPY ["Delgato.Agents/Delgato.Agents.csproj", "Delgato.Agents/"]
COPY ["Delgato.Transports/Delgato.Transports.csproj", "Delgato.Transports/"]
COPY ["Delgato.Tools/Delgato.Tools.csproj", "Delgato.Tools/"]
COPY ["Delgato.Policies/Delgato.Policies.csproj", "Delgato.Policies/"]
COPY ["Delgato.Cli/Delgato.Cli.csproj", "Delgato.Cli/"]
COPY ["Delgato/Delgato.csproj", "Delgato/"]

# Restore dependencies
RUN dotnet restore "Delgato.Cli/Delgato.Cli.csproj"

# Copy source code
COPY . .

# Build
WORKDIR "/src/Delgato.Cli"
RUN dotnet build "Delgato.Cli.csproj" -c Release -o /app/build

# Publish stage
FROM build AS publish
RUN dotnet publish "Delgato.Cli.csproj" -c Release -o /app/publish /p:UseAppHost=true /p:PublishSingleFile=true

# Final stage
FROM base AS final
WORKDIR /app

# Create non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser appuser && chown -R appuser:appuser /app
USER appuser

COPY --from=publish /app/publish .

# Labels
LABEL org.opencontainers.image.title="Delgato CLI"
LABEL org.opencontainers.image.description="Enterprise Agent Swarm CLI"
LABEL org.opencontainers.image.vendor="Delgato"
LABEL org.opencontainers.image.source="https://github.com/JerrettDavis/Delgato"

ENTRYPOINT ["./Delgato.Cli"]
