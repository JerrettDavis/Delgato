{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "Delgato/Delgato.csproj",
            "Delgato.Core/Delgato.Core.csproj",
            "Delgato.Agents/Delgato.Agents.csproj",
            "Delgato.Configuration/Delgato.Configuration.csproj",
            "Delgato.Governance/Delgato.Governance.csproj",
            "Delgato.Orchestration/Delgato.Orchestration.csproj",
            "Delgato.Policies/Delgato.Policies.csproj",
            "Delgato.Providers/Delgato.Providers.csproj",
            "Delgato.Tools/Delgato.Tools.csproj",
            "Delgato.Transports/Delgato.Transports.csproj",
            "Delgato.Cli/Delgato.Cli.csproj"
          ],
          "src": "../.."
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml", "api/index.md"]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "resource": [
      {
        "files": ["images/**"]
      }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appTitle": "Delgato Documentation",
      "_appName": "Delgato",
      "_appFooter": "Delgato Enterprise Agent Swarm Ecosystem",
      "_enableSearch": true,
      "_enableNewTab": true
    }
  }
}
