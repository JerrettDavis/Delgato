@page "/audit"
@using Delgato.Core.Governance
@inject IServiceProvider ServiceProvider
@inject ILogger<Audit> Logger
@rendermode InteractiveServer

<PageTitle>Audit Log - Delgato</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">
            <i class="bi bi-journal-text me-2"></i>Audit Log
        </h1>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" @onclick="ExportAuditLog">
                <i class="bi bi-download me-1"></i>Export
            </button>
            <button class="btn btn-outline-secondary" @onclick="RefreshAuditLog">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Event Type</label>
                    <input type="text" class="form-control" @bind="FilterEventType" placeholder="Filter by type..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Actor ID</label>
                    <input type="text" class="form-control" @bind="FilterActorId" placeholder="Filter by actor..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Outcome</label>
                    <select class="form-select" @bind="FilterOutcome">
                        <option value="">All</option>
                        <option value="Success">Success</option>
                        <option value="Failure">Failure</option>
                        <option value="Denied">Denied</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-primary w-100" @onclick="ApplyFilters">
                        <i class="bi bi-search me-1"></i>Search
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics -->
    @if (Statistics != null)
    {
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <h4 class="mb-0">@Statistics.TotalEvents.ToString("N0")</h4>
                        <small class="text-muted">Total Events</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <h4 class="mb-0 text-success">@Statistics.SuccessRate.ToString("P1")</h4>
                        <small class="text-muted">Success Rate</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <h4 class="mb-0">@Statistics.AverageDuration.TotalMilliseconds.ToString("F0")ms</h4>
                        <small class="text-muted">Avg Duration</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <h4 class="mb-0">@Statistics.EventsByCategory.Count</h4>
                        <small class="text-muted">Categories</small>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Audit Events Table -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Recent Events</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Timestamp</th>
                        <th>Event Type</th>
                        <th>Category</th>
                        <th>Actor</th>
                        <th>Resource</th>
                        <th>Action</th>
                        <th>Outcome</th>
                        <th>Duration</th>
                    </tr>
                </thead>
                <tbody>
                    @if (AuditEvents.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                No audit events found
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var evt in AuditEvents)
                        {
                            <tr>
                                <td><small>@evt.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</small></td>
                                <td><code>@evt.EventType</code></td>
                                <td><span class="badge @GetCategoryClass(evt.Category)">@evt.Category</span></td>
                                <td><small>@evt.ActorId</small></td>
                                <td><small>@evt.ResourceType/@evt.ResourceId</small></td>
                                <td>@evt.Action</td>
                                <td><span class="badge @GetOutcomeClass(evt.Outcome)">@evt.Outcome</span></td>
                                <td>@(evt.Duration?.TotalMilliseconds.ToString("F0") ?? "-")ms</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (TotalPages > 1)
        {
            <div class="card-footer">
                <nav>
                    <ul class="pagination mb-0 justify-content-center">
                        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(CurrentPage - 1)">Previous</button>
                        </li>
                        @for (int i = 1; i <= TotalPages; i++)
                        {
                            var page = i;
                            <li class="page-item @(CurrentPage == page ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPage(page)">@(page)</button>
                            </li>
                        }
                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(CurrentPage + 1)">Next</button>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@code {
    private List<AuditEvent> AuditEvents = new();
    private AuditStatistics? Statistics;
    private int CurrentPage = 1;
    private int TotalPages = 1;
    private const int PageSize = 20;

    // Filters
    private string FilterEventType = "";
    private string FilterActorId = "";
    private string FilterOutcome = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadAuditData();
    }

    private async Task LoadAuditData()
    {
        var auditService = ServiceProvider.GetService<IAuditService>();
        if (auditService == null) return;

        try
        {
            var query = new AuditQuery
            {
                EventTypes = string.IsNullOrEmpty(FilterEventType) ? null : new[] { FilterEventType },
                ActorId = string.IsNullOrEmpty(FilterActorId) ? null : FilterActorId,
                Outcome = string.IsNullOrEmpty(FilterOutcome) ? null : Enum.Parse<AuditOutcome>(FilterOutcome),
                PageNumber = CurrentPage,
                PageSize = PageSize,
                SortDescending = true
            };

            var result = await auditService.QueryAsync(query);
            AuditEvents = result.Events.ToList();
            TotalPages = result.TotalPages;

            // Load statistics
            var now = DateTimeOffset.UtcNow;
            Statistics = await auditService.GetStatisticsAsync(now.AddDays(-7), now);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load audit data");
        }
    }

    private async Task RefreshAuditLog()
    {
        await LoadAuditData();
    }

    private async Task ApplyFilters()
    {
        CurrentPage = 1;
        await LoadAuditData();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        CurrentPage = page;
        await LoadAuditData();
    }

    private async Task ExportAuditLog()
    {
        // Trigger download
    }

    private string GetCategoryClass(AuditEventCategory category) => category switch
    {
        AuditEventCategory.Security => "bg-danger",
        AuditEventCategory.Agent => "bg-primary",
        AuditEventCategory.Tool => "bg-info",
        AuditEventCategory.Orchestration => "bg-warning",
        _ => "bg-secondary"
    };

    private string GetOutcomeClass(AuditOutcome outcome) => outcome switch
    {
        AuditOutcome.Success => "bg-success",
        AuditOutcome.Failure => "bg-danger",
        AuditOutcome.Denied => "bg-warning",
        AuditOutcome.Timeout => "bg-secondary",
        _ => "bg-info"
    };
}
